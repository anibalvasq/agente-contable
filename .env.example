# ─────────────────────────────────────────────────────────────
# agente-contable — variables de entorno
#
# ESTE archivo (.env.example) es la PLANTILLA: se sube a GitHub y nunca lleva
# credenciales. Copia a .env (que está en .gitignore) y edita ahí.
#
# En Vercel las mismas variables van en Settings → Environment Variables
# (marca Preview y Production). Ver supabase/agente_contable_seguridad.sql para
# el rol de base de datos con el que se conecta la app.
# ─────────────────────────────────────────────────────────────

# ── Núcleo ────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Persistencia. 'memory' = todo en RAM (demo, sin DB). 'postgres' = persistente.
STORE=memory
# Solo si STORE=postgres:
# DATABASE_URL=postgres://agent:agent@localhost:5432/agent

# Redis es opcional: solo escala los límites de tasa y de gasto a varias instancias.
# REDIS_URL=redis://localhost:6379

# Canal de mensajería activo (hoy solo telegram). El panel y el MCP no lo necesitan.
CHANNEL_ADAPTER=telegram

# Secreto compartido para validar webhooks de los canales.
# Genera uno con:  openssl rand -hex 32
WEBHOOK_SECRET=

# Exigir que TODOS los webhooks vengan firmados o autenticados. Déjalo en true.
# Un webhook sin verificar es una puerta abierta: la URL es adivinable, y con
# ella un tercero puede inyectar mensajes falsos y gastarte el saldo del LLM.
# Ponlo en false SOLO para probar en local.
WEBHOOK_REQUIRE_SIGNATURE=true

# Límites de tasa. Por IP frena la fuerza bruta; por contacto protege la
# billetera (un número que manda 60 mensajes por minuto no es un cliente).
RATE_LIMIT_PER_IP=120
RATE_LIMIT_PER_CONTACT=15

# Firma los ids de sesión. En producción es obligatorio. Si lo dejas vacío (local) se genera uno al azar
# por proceso y las sesiones se pierden en cada reinicio.
# Genera uno con:  openssl rand -hex 32
SESSION_SECRET=

# Clave del panel del estudio (http://localhost:3000/panel), mínimo 12 caracteres.
# Vacía: en local el panel entra sin clave; en producción queda APAGADO.
PANEL_PASSWORD=

# Llave con que se cifran las claves de las empresas (SII, Previred, Defontana)
# en la base. Genera una con:  npm run claves:importar -- --generar-llave
# Guárdala también en tu gestor de contraseñas: sin ella las claves no se recuperan.
CREDENTIALS_KEY=

# Supabase Auth: login del panel con usuarios y roles. Requiere STORE=postgres.
# URL y clave pública: Supabase → Settings → API. La service role key es SECRETA:
# solo hace falta para crear cuentas y va únicamente en el servidor.
# DATABASE_URL: usa el rol agente_contable_app (ver supabase/agente_contable_seguridad.sql)
# con la conexión del pooler, y DATABASE_SSL=require.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_SSL=

# Token para conectar el Claude del cliente (claude.ai, Desktop o Claude Code) al
# servidor MCP del estudio en /mcp. Vacío = /mcp apagado. Genera uno con:
#   openssl rand -hex 32
MCP_TOKEN=

# ── LLM ───────────────────────────────────────────────────────
# Necesitas UNA API key: la de OpenRouter, o la de un proveedor directo.
#
# OpenRouter (https://openrouter.ai/keys):
OPENROUTER_API_KEY=
#
# Anthropic directo (https://platform.claude.com) u OpenAI: completa estas dos;
# mandan sobre OPENROUTER_*. Para Anthropic, LLM_BASE_URL=https://api.anthropic.com/v1/
LLM_API_KEY=
LLM_BASE_URL=
#
# Con OpenRouter: anthropic/claude-sonnet-4.5, openai/gpt-4.1-mini, etc.
# Con Anthropic directo, sin prefijo: claude-haiku-4-5-20251001, claude-sonnet-5-5…
LLM_MODEL=anthropic/claude-sonnet-4.5
LLM_MAX_TOKENS=1024
# Vacía = la decide el modelo. Los modelos nuevos de Claude la rechazan (error 400).
LLM_TEMPERATURE=
APP_TITLE=agente-contable

# ── Agente ────────────────────────────────────────────────────
AGENT_CONFIG_PATH=config/agent.yaml
# Espera tras el último mensaje antes de responder (junta los mensajitos sueltos).
MESSAGE_DEBOUNCE_MS=8000
AGENT_MAX_TOOL_ITERATIONS=6
AGENT_HISTORY_LIMIT=40
# false = ejecuta el agente pero NO envía (modo observación).
AGENT_REPLY_ENABLED=true

# Los topes de gasto y las guardas anti-inyección NO viven aquí: van en
# config/agent.yaml, sección `guardrails`, para que se editen junto con la
# personalidad del agente y sin tocar variables de entorno.

# ── Avisos al desarrollador (Resend) ──────────────────────────
# Un agente que falla en silencio es peor que uno que no existe: el cliente
# queda esperando y tú te enteras cuando te reclaman. Con esto te llegan por
# mail los tres eventos que exigen a una persona:
#   · un handoff a un humano
#   · un turno abandonado tras agotar los reintentos
#   · el presupuesto diario agotado (el agente dejó de responder a TODOS)
#
# Si dejas RESEND_API_KEY vacío no se manda nada y todo queda en los logs.
# El kit funciona igual — pero enterarte tarde también es una decisión.
# https://resend.com/api-keys
RESEND_API_KEY=
# A quién le llegan los avisos: tú, el que está desarrollando esto.
ALERT_EMAIL_TO=
# Tiene que ser de un dominio verificado en Resend. onboarding@resend.dev viene
# listo para probar, pero SOLO puede escribirle a la casilla con la que creaste
# la cuenta de Resend.
ALERT_EMAIL_FROM=onboarding@resend.dev

# ─────────────────────────────────────────────────────────────
# Canales de mensajería
# ─────────────────────────────────────────────────────────────

# ── Telegram (CHANNEL_ADAPTER=telegram) ───────────────────────
# Token de @BotFather (/newbot).
TELEGRAM_BOT_TOKEN=
# Ids numéricos autorizados, separados por coma (tu id lo da @userinfobot).
# Sin esto cualquiera que encuentre el bot puede gastar tu saldo del LLM.
TELEGRAM_ALLOWED_USER_IDS=
