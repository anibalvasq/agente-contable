# ─────────────────────────────────────────────────────────────
# wa-agent-starter — variables de entorno
#
# ESTE archivo (.env.example) es la PLANTILLA. Se sube a GitHub y nunca lleva
# credenciales. NO edites este: edita el .env.
#
# El .env se te crea solo al ejecutar `npm install` (nunca pisa uno existente)
# y está en .gitignore, así que tus claves no se suben. Es el único que tocas.
#
# El camino, en orden:
#   1. Probar en local     → solo OPENROUTER_API_KEY
#                            npm run demo (web)  ·  npm run chat (terminal)
#   2. Desplegar           → COOLIFY_URL + COOLIFY_API_TOKEN → npm run deploy
#   3. Conectar tu canal   → recién ahí tienes una URL pública para el webhook
# ─────────────────────────────────────────────────────────────

# ── Núcleo ────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Persistencia. 'memory' = todo en RAM (demo, sin DB). 'postgres' = persistente.
STORE=memory
# Solo si STORE=postgres:
# DATABASE_URL=postgres://agent:agent@localhost:5432/agent

# Cola de mensajes (solo la usan los canales por webhook). El demo web no la usa.
REDIS_URL=redis://localhost:6379

# Qué frontend está activo: web | cloud-api | ghl | chatwoot | ycloud
CHANNEL_ADAPTER=web

# Secreto compartido para validar webhooks (GHL, Chatwoot, YCloud).
# Genera uno con:  openssl rand -hex 32
WEBHOOK_SECRET=

# Exigir que TODOS los webhooks vengan firmados o autenticados. Déjalo en true.
# Un webhook sin verificar es una puerta abierta: la URL es adivinable, y con
# ella un tercero puede inyectar mensajes falsos, gastarte el saldo del LLM y
# —en cloud-api— hacer que TU número le mande WhatsApp a quien él elija.
# Ponlo en false SOLO para probar en local.
WEBHOOK_REQUIRE_SIGNATURE=true

# Límites de tasa. Por IP frena la fuerza bruta; por contacto protege la
# billetera (un número que manda 60 mensajes por minuto no es un cliente).
RATE_LIMIT_PER_IP=120
RATE_LIMIT_PER_CONTACT=15

# Firma los ids de sesión del canal web. Si lo dejas vacío se genera uno al azar
# por proceso y las sesiones se pierden en cada reinicio.
# Genera uno con:  openssl rand -hex 32
SESSION_SECRET=

# ── LLM (OpenRouter) ──────────────────────────────────────────
# API key: https://openrouter.ai/keys   ← lo ÚNICO imprescindible para el demo
OPENROUTER_API_KEY=
# Cualquier modelo de OpenRouter con tool calling: anthropic/claude-sonnet-4.5,
# openai/gpt-4.1-mini, google/gemini-2.5-flash, etc.
LLM_MODEL=anthropic/claude-sonnet-4.5
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.3
APP_TITLE=wa-agent-starter

# ── Agente ────────────────────────────────────────────────────
AGENT_CONFIG_PATH=config/agent.yaml
# Espera tras el último mensaje antes de responder (junta los mensajitos sueltos).
MESSAGE_DEBOUNCE_MS=8000
AGENT_MAX_TOOL_ITERATIONS=6
AGENT_HISTORY_LIMIT=40
# false = ejecuta el agente pero NO envía (modo observación).
AGENT_REPLY_ENABLED=true

# Los topes de gasto y las guardas anti-inyección NO viven aquí: van en
# config/agent.yaml, sección `guardrails`, para que se editen junto con la
# personalidad del agente y sin tocar variables de entorno.

# ── Avisos al desarrollador (Resend) ──────────────────────────
# Un agente que falla en silencio es peor que uno que no existe: el cliente
# queda esperando y tú te enteras cuando te reclaman. Con esto te llegan por
# mail los tres eventos que exigen a una persona:
#   · un handoff a un humano
#   · un turno abandonado tras agotar los reintentos
#   · el presupuesto diario agotado (el agente dejó de responder a TODOS)
#
# Si dejas RESEND_API_KEY vacío no se manda nada y todo queda en los logs.
# El kit funciona igual — pero enterarte tarde también es una decisión.
# https://resend.com/api-keys
RESEND_API_KEY=
# A quién le llegan los avisos: tú, el que está desarrollando esto.
ALERT_EMAIL_TO=
# Tiene que ser de un dominio verificado en Resend. onboarding@resend.dev viene
# listo para probar, pero SOLO puede escribirle a la casilla con la que creaste
# la cuenta de Resend.
ALERT_EMAIL_FROM=onboarding@resend.dev

# ─────────────────────────────────────────────────────────────
# Coolify — DONDE VIVE TODO EL BACKEND
#
# Para hablar con WhatsApp de verdad necesitas una URL pública con HTTPS:
# ninguna plataforma le pega a tu computadora. Desplegar es el paso PREVIO a
# conectar cualquier canal, no el último paso.
#
#   npm run deploy     provisiona y despliega (primera vez, o si cambias esto)
#   npm run redeploy   solo dispara un despliegue nuevo (el del día a día)
#
# La app NO lee estas variables: son solo para esos dos comandos.
#
#   COOLIFY_URL        tu panel, sin barra final
#   COOLIFY_API_TOKEN  Coolify → Keys & Tokens → API tokens
#   GITHUB_TOKEN       token con permiso sobre el repo (solo para el primer deploy:
#                      registra una deploy key de solo lectura para que Coolify clone)
#   GITHUB_REPO        la URL de tu repo
# ─────────────────────────────────────────────────────────────
# COOLIFY_URL=https://coolify.tu-dominio.com
# COOLIFY_API_TOKEN=
# GITHUB_TOKEN=
# GITHUB_REPO=https://github.com/tu-usuario/tu-repo.git
# Nombres en Coolify (opcionales). redeploy busca la app por APP_NAME.
# PROJECT_NAME=wa-agent-starter
# APP_NAME=wa-agent

# ─────────────────────────────────────────────────────────────
# Variables por canal. Completa SOLO las del canal que uses.
# Antes de tocar esto necesitas la URL pública del paso anterior.
# ─────────────────────────────────────────────────────────────

# ── WhatsApp Cloud API (CHANNEL_ADAPTER=cloud-api) ────────────
# Meta for Developers → tu app → WhatsApp → API Setup
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
# El verify token lo inventas tú y lo repites en el dashboard de Meta.
META_VERIFY_TOKEN=
# OBLIGATORIO (a menos que pongas WEBHOOK_REQUIRE_SIGNATURE=false).
# Con esto se valida la firma HMAC de cada webhook. Sin esto, cualquiera que
# conozca tu URL puede hacer que tu número le mande mensajes a quien quiera.
# Meta for Developers → tu app → Settings → Basic → App Secret
META_APP_SECRET=

# ── GoHighLevel (CHANNEL_ADAPTER=ghl) ─────────────────────────
GHL_API_TOKEN=
GHL_LOCATION_ID=
# La etiqueta que se le pone al contacto cuando el agente deriva a un humano.
# Es LA pieza del handoff en GHL: con esta tag armas un Smart List o disparas
# un workflow que le avisa al vendedor. Pon la que ya use tu operación.
GHL_HANDOFF_TAG=bot-handoff

# ── Chatwoot (CHANNEL_ADAPTER=chatwoot) — stub ────────────────
# Además de estas, necesita WEBHOOK_SECRET (arriba): el stub también encola
# trabajo y hace ejecutar el LLM, así que no puede quedar abierto.
CHATWOOT_BASE_URL=
CHATWOOT_API_TOKEN=
CHATWOOT_ACCOUNT_ID=

# ── YCloud (CHANNEL_ADAPTER=ycloud) — stub ────────────────────
# Necesita también WEBHOOK_SECRET (arriba).
YCLOUD_API_KEY=
