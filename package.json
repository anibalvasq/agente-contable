{
  "name": "agente-contable",
  "version": "0.1.0",
  "description": "Agente contable del estudio: panel, procesos F29/Previred, bóveda de claves, reglas de correo y MCP. Vercel + Supabase.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "migrate": "tsx src/db/migrate.ts",
    "claves:importar": "tsx scripts/importar-claves.ts",
    "empresas:importar": "tsx scripts/importar-empresas.ts",
    "recordatorios": "tsx scripts/recordatorios.ts",
    "usuarios:crear-admin": "tsx scripts/crear-admin.ts",
    "typecheck": "tsc --noEmit",
    "test": "cross-env OPENROUTER_API_KEY=test-key STORE=memory node --import tsx --test \"src/**/*.test.ts\"",
    "panel": "tsx watch src/dev.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "dotenv": "^16.4.5",
    "fastify": "^5.0.0",
    "ioredis": "^5.4.1",
    "openai": "^4.56.0",
    "pg": "^8.12.0",
    "pino": "^9.3.2",
    "yaml": "^2.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "cross-env": "^7.0.3",
    "pino-pretty": "^11.2.2",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
