{
  "name": "wa-agent-starter",
  "version": "0.1.0",
  "description": "Boilerplate para agentes de IA de WhatsApp: OpenRouter + Redis + frontend pluggable (Cloud API, GHL, Chatwoot, YCloud, web) + deploy en Coolify.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "migrate": "tsx src/db/migrate.ts",
    "setup": "tsx scripts/setup.ts",
    "chat": "tsx scripts/chat.ts",
    "demo": "cross-env CHANNEL_ADAPTER=web STORE=memory tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "deploy": "tsx scripts/deploy-coolify.ts",
    "redeploy": "tsx scripts/redeploy-coolify.ts",
    "test": "cross-env OPENROUTER_API_KEY=test-key STORE=memory node --import tsx --test \"src/**/*.test.ts\"",
    "postinstall": "tsx scripts/ensure-env.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.3",
    "bullmq": "^5.12.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.0.0",
    "ioredis": "^5.4.1",
    "openai": "^4.56.0",
    "pg": "^8.12.0",
    "pino": "^9.3.2",
    "yaml": "^2.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "cross-env": "^7.0.3",
    "ioredis-mock": "^8.13.1",
    "pino-pretty": "^11.2.2",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
